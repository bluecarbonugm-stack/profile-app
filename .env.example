# Konten Web Profile (Supabase)
#
# Salin file ini menjadi `.env`, lalu isi nilainya. Jangan commit `.env`.
#
# PENTING: variabel di bawah TIDAK boleh diberi awalan VITE_ — variabel VITE_*
# ikut ter-bundle ke browser dan endpoint/key-nya jadi publik. Semua akses
# Supabase (baca konten publik maupun tulis dari /admin) berjalan di server
# lewat TanStack server functions, bukan dari klien.

# Server-only. Dipakai untuk membaca konten publik (site, stats, team, dst).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only. Dipakai admin (/admin) untuk tulis/hapus data + upload gambar
# ke Supabase Storage. Bypass RLS — jangan pernah dikirim ke klien.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email admin tunggal yang diizinkan login ke /admin. Harus sama dengan email
# akun yang dibuat di Supabase Auth.
ADMIN_EMAIL=admin@example.org

# Opsional. Lama cache konten profil di server, dalam detik. Default 300 (5 menit).
PROFILE_CONTENT_TTL_SECONDS=300

# Opsional, hanya untuk migrasi via CLI (mis. Supabase CLI / psql). Tidak
# dipakai oleh aplikasi saat runtime.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Dikosongkan = situs memakai konten fallback bawaan di
# src/features/profile/data/fallback-content.ts kalau Supabase tidak
# terjangkau atau belum dikonfigurasi.
