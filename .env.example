# Konten Web Profile (Google Apps Script + Spreadsheet)
#
# Salin file ini menjadi `.env`, lalu isi nilainya. Jangan commit `.env`.
# Panduan setup lengkap: scripts/apps-script/README.md
#
# PENTING: variabel di bawah TIDAK boleh diberi awalan VITE_ — variabel VITE_*
# ikut ter-bundle ke browser dan endpoint-nya jadi publik.

# URL Web App hasil deploy Apps Script (berakhiran /exec).
# Dikosongkan = situs memakai konten fallback bawaan di
# src/features/profile/data/fallback-content.ts
PROFILE_CONTENT_ENDPOINT= https://script.google.com/macros/s/AKfycbysL5C9hb14IyjR61p-hoHbfXsx3mKW3FsRZYZc74Zt7x6EFvsaXoh98HwTpKMzvUqj/exec

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
